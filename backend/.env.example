# ============= DATABASE =============
DATABASE_URL="postgresql://username:password@localhost:5432/civic_issues"
DIRECT_URL="postgresql://username:password@localhost:5432/civic_issues"

# ============= SERVER =============
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ============= JWT =============
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# ============= EMAIL (SMTP) =============
# Gmail: use an App Password (not your regular password)
# Outlook: use smtp-mail.outlook.com with your regular password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="VMC Civic Issues <noreply@vmc.gov.in>"

# ============= CLOUDINARY =============
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============= REDIS =============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_USE_TLS=false
# For Redis Cloud / ElastiCache:
# REDIS_HOST=your-redis-host.com
# REDIS_PORT=6380
# REDIS_USERNAME=your-redis-username
# REDIS_PASSWORD=your-redis-password
# REDIS_USE_TLS=true

# ============= GOOGLE CLOUD VISION =============
GOOGLE_VISION_KEY_PATH=./google-vision-key.json
GOOGLE_CLOUD_PROJECT_ID=your-project-id
